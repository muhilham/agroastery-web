# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # public anon key
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # server-side only — never expose to client

# ─── Xendit ──────────────────────────────────────────────────────────────────
XENDIT_SECRET_KEY=xnd_production_...          # server-side only
XENDIT_WEBHOOK_TOKEN=...                      # for verifying webhook signatures
NEXT_PUBLIC_XENDIT_PUBLIC_KEY=xnd_public_production_...  # for popup widget
# Set to "true" in local dev to bypass Xendit API (no real credentials needed)
XENDIT_MOCK=false

# ─── Biteship ────────────────────────────────────────────────────────────────
BITESHIP_API_KEY=sk_test_replace_me
NEXT_PUBLIC_BITESHIP_DEFAULT_COURIERS=anteraja,jne,sicepat

# ─── Google Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://agroastery.com    # used for Xendit callback URLs

# ─── Telegram Notifications ───────────────────────────────────────────────────
# Bot token from @BotFather. Chat ID can be a group (negative int) or channel (@username).
# Leave blank to disable order notifications.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# ─── Origin / Store info ─────────────────────────────────────────────────────
NEXT_PUBLIC_ORIGIN_POSTAL_CODE=12440
NEXT_PUBLIC_ORIGIN_NAME=Agroastery
NEXT_PUBLIC_ORIGIN_PHONE=08123456789
NEXT_PUBLIC_ORIGIN_EMAIL="AGROASTERY.ID@gmail.com"
NEXT_PUBLIC_ORIGIN_ADDRESS=Jl. Origin Address
NEXT_PUBLIC_ORIGIN_LAT="-6.263450138760574"
NEXT_PUBLIC_ORIGIN_LNG="106.81945752406575"
# Server-side variants (used by some Biteship endpoints)
ORIGIN_CONTACT_NAME=Agroastery
ORIGIN_CONTACT_PHONE=08123456789
ORIGIN_ADDRESS=Jl. Origin Address
ORIGIN_LATITUDE="-6.263450138760574"
ORIGIN_LONGITUDE="106.81945752406575"

# ─── Packaging ───────────────────────────────────────────────────────────────
PACKAGING_EXTRA_GRAMS=0
PACKAGING_EXTRA_PERCENT=0

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-random-secret  # protects /api/admin/* endpoints

# ─── Jubelio (ERP / inventory sync) ──────────────────────────────────────────
JUBELIO_EMAIL=your-jubelio-email@example.com
JUBELIO_PASSWORD=your-jubelio-password

# ─── Legacy (no longer needed after Supabase migration) ──────────────────────
# CATALOG_BASE=https://cdn.agroastery.com/produk   # replaced by Supabase products
